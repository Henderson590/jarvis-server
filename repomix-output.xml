<file path="assistant/memory/store.py">
"""
CRUD and retrieval for Jarvis's memory. Four memory types, matching the
original spec:

  semantic_facts    - facts about the user ("works as a electrician")
  preferences        - favorite software/browser/IDE/music/etc, keyed by category
  procedural_rules   - how the user likes tasks done ("when I say X, do Y")
  episodic_events     - a running log of what happened, for "what did we do" recall

Retrieval is plain keyword overlap + recency, not embeddings - deliberately,
to avoid pulling in a heavier dependency for Phase 2. Embedding-based
semantic search can replace this later without changing the tool/planner
contract, since everything routes through build_context_block().
"""
from __future__ import annotations

import re
from datetime import datetime, timezone
from typing import Dict, List, Optional

from . import db

_MAX_EPISODIC_EVENTS = 500  # oldest events get pruned past this
_STOPWORDS = {
    "the", "a", "an", "is", "are", "was", "were", "to", "of", "and", "or",
    "in", "on", "at", "for", "with", "my", "me", "i", "you", "your", "it",
    "that", "this", "do", "does", "did", "can", "could", "please", "what",
    "when", "how", "should", "would", "will", "want", "need",
}


def _now() -> str:
    return datetime.now(timezone.utc).isoformat()


def _words(text: str) -> set:
    tokens = re.findall(r"[a-z0-9']+", (text or "").lower())
    return {t for t in tokens if t not in _STOPWORDS and len(t) > 1}


# --------------------------------------------------------------------------
# Semantic facts
# --------------------------------------------------------------------------

def remember_fact(key: str, value: str, confidence: float = 1.0) -> str:
    key = key.strip()
    value = value.strip()
    now = _now()
    conn = db.get_connection()
    try:
        conn.execute(
            """
            INSERT INTO semantic_facts (key, value, confidence, created_at, updated_at)
            VALUES (?, ?, ?, ?, ?)
            ON CONFLICT(key) DO UPDATE SET
                value = excluded.value,
                confidence = excluded.confidence,
                updated_at = excluded.updated_at
            """,
            (key, value, confidence, now, now),
        )
        conn.commit()
    finally:
        conn.close()
    return f"Remembered: {key} = {value}"


def forget_fact(key: str) -> str:
    conn = db.get_connection()
    try:
        cur = conn.execute("DELETE FROM semantic_facts WHERE key = ?", (key.strip(),))
        conn.commit()
        return f"Forgot '{key}'." if cur.rowcount else f"Didn't have anything stored for '{key}'."
    finally:
        conn.close()


def get_relevant_facts(query: str, limit: int = 6) -> List[str]:
    conn = db.get_connection()
    try:
        rows = conn.execute(
            "SELECT key, value FROM semantic_facts ORDER BY updated_at DESC"
        ).fetchall()
    finally:
        conn.close()
    query_words = _words(query)
    scored = []
    for row in rows:
        text_words = _words(f"{row['key']} {row['value']}")
        score = len(query_words & text_words)
        scored.append((score, row["key"], row["value"]))
    scored.sort(key=lambda t: t[0], reverse=True)
    top = [t for t in scored if t[0] > 0][:limit]
    if not top:
        top = scored[:min(3, limit)]  # no keyword match - fall back to most recent
    return [f"{k}: {v}" for _, k, v in top]


# --------------------------------------------------------------------------
# Preferences
# --------------------------------------------------------------------------

def remember_preference(category: str, value: str) -> str:
    category = category.strip().lower()
    value = value.strip()
    now = _now()
    conn = db.get_connection()
    try:
        conn.execute(
            """
            INSERT INTO preferences (category, value, created_at, updated_at)
            VALUES (?, ?, ?, ?)
            ON CONFLICT(category) DO UPDATE SET
                value = excluded.value,
                updated_at = excluded.updated_at
            """,
            (category, value, now, now),
        )
        conn.commit()
    finally:
        conn.close()
    return f"Got it - preferred {category}: {value}"


def get_preference(category: str) -> Optional[str]:
    conn = db.get_connection()
    try:
        row = conn.execute(
            "SELECT value FROM preferences WHERE category = ?", (category.strip().lower(),)
        ).fetchone()
        return row["value"] if row else None
    finally:
        conn.close()


def get_all_preferences() -> Dict[str, str]:
    conn = db.get_connection()
    try:
        rows = conn.execute("SELECT category, value FROM preferences ORDER BY category").fetchall()
        return {row["category"]: row["value"] for row in rows}
    finally:
        conn.close()


# --------------------------------------------------------------------------
# Procedural rules
# --------------------------------------------------------------------------

def remember_procedure(trigger: str, action: str) -> str:
    now = _now()
    conn = db.get_connection()
    try:
        conn.execute(
            "INSERT INTO procedural_rules (trigger, action, created_at) VALUES (?, ?, ?)",
            (trigger.strip(), action.strip(), now),
        )
        conn.commit()
    finally:
        conn.close()
    return f"Noted - when {trigger}, {action}."


def get_relevant_procedures(query: str, limit: int = 4) -> List[str]:
    conn = db.get_connection()
    try:
        rows = conn.execute(
            "SELECT trigger, action FROM procedural_rules ORDER BY created_at DESC"
        ).fetchall()
    finally:
        conn.close()
    query_words = _words(query)
    scored = []
    for row in rows:
        text_words = _words(f"{row['trigger']} {row['action']}")
        score = len(query_words & text_words)
        scored.append((score, row["trigger"], row["action"]))
    scored.sort(key=lambda t: t[0], reverse=True)
    top = [t for t in scored if t[0] > 0][:limit]
    return [f"When {trig}: {act}" for _, trig, act in top]


# --------------------------------------------------------------------------
# Episodic events
# --------------------------------------------------------------------------

def log_episodic(summary: str) -> None:
    now = _now()
    conn = db.get_connection()
    try:
        conn.execute(
            "INSERT INTO episodic_events (summary, created_at) VALUES (?, ?)",
            (summary.strip()[:500], now),
        )
        # Prune old events past the cap so this table never grows unbounded.
        conn.execute(
            """
            DELETE FROM episodic_events WHERE id NOT IN (
                SELECT id FROM episodic_events ORDER BY id DESC LIMIT ?
            )
            """,
            (_MAX_EPISODIC_EVENTS,),
        )
        conn.commit()
    finally:
        conn.close()


def get_recent_episodic(limit: int = 4) -> List[str]:
    conn = db.get_connection()
    try:
        rows = conn.execute(
            "SELECT summary FROM episodic_events ORDER BY id DESC LIMIT ?", (limit,)
        ).fetchall()
        return [row["summary"] for row in rows]
    finally:
        conn.close()


# --------------------------------------------------------------------------
# Context building for the planner, and a human-readable dump for the user
# --------------------------------------------------------------------------

def build_context_block(user_message: str) -> str:
    """Returns a system-prompt-ready block of the memory most relevant to
    this turn. Empty string if there's nothing stored yet."""
    facts = get_relevant_facts(user_message, limit=6)
    prefs = get_all_preferences()
    procs = get_relevant_procedures(user_message, limit=4)
    recent = get_recent_episodic(limit=4)

    sections = []
    if facts:
        sections.append("Known facts about the user:\n" + "\n".join(f"- {f}" for f in facts))
    if prefs:
        pref_lines = "\n".join(f"- {cat}: {val}" for cat, val in prefs.items())
        sections.append("Stated preferences:\n" + pref_lines)
    if procs:
        sections.append("How the user likes certain things done:\n" + "\n".join(f"- {p}" for p in procs))
    if recent:
        sections.append("Recently:\n" + "\n".join(f"- {r}" for r in recent))

    if not sections:
        return ""
    return "What you remember about the user:\n\n" + "\n\n".join(sections)


def summarize_all() -> str:
    """Human-readable dump of everything stored - what the list_what_you_know
    tool returns when the user asks "what do you know about me"."""
    conn = db.get_connection()
    try:
        facts = conn.execute("SELECT key, value FROM semantic_facts ORDER BY updated_at DESC").fetchall()
        procs = conn.execute("SELECT trigger, action FROM procedural_rules ORDER BY created_at DESC").fetchall()
    finally:
        conn.close()
    prefs = get_all_preferences()

    lines = []
    if facts:
        lines.append("Facts:")
        lines.extend(f"  - {r['key']}: {r['value']}" for r in facts)
    if prefs:
        lines.append("Preferences:")
        lines.extend(f"  - {cat}: {val}" for cat, val in prefs.items())
    if procs:
        lines.append("Habits/rules:")
        lines.extend(f"  - When {r['trigger']}: {r['action']}" for r in procs)
    if not lines:
        return "I don't have anything stored yet."
    return "\n".join(lines)
