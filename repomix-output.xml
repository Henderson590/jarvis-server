<file path="assistant/agent/planner.py">
"""
The planner: an agentic tool-calling loop.

Replaces the old regex-cascade brain.py. Instead of matching ~40 hand-written
regex patterns against the user's exact phrasing, the LLM is given a registry
of tools (JSON-schema function definitions) and decides which ones to call,
in what order, with what arguments. This is what lets the assistant handle
paraphrasing, multi-step requests, and new capabilities without brain.py
growing forever - adding a capability now means adding a tool, not another
regex branch.

Flow per user turn:
  1. If a tool call is awaiting yes/no confirmation from last turn, resolve that first.
  2. Otherwise, send the conversation + tool schemas to Ollama.
  3. If the model responds with tool call(s), execute each (or pause for
     confirmation if the tool requires it), feed results back, and loop.
  4. Stop when the model responds with plain text instead of a tool call, or
     after a small iteration cap (a safety valve against infinite tool loops).
"""
from __future__ import annotations

import json
import re
from typing import Optional

import config

from . import registry
# Import so their @tool decorators run and register into the registry.
from . import tools_system      # noqa: F401
from . import tools_files       # noqa: F401
from . import tools_web         # noqa: F401
from . import tools_productivity  # noqa: F401
from . import tools_vision      # noqa: F401
from . import tools_blender     # noqa: F401
from . import tools_memory      # noqa: F401
from ..memory import store as memory_store

_HISTORY_SIZE = getattr(config, "CONVERSATION_HISTORY_SIZE", 4)
_STRIP_ROLEPLAY = getattr(config, "STRIP_ROLEPLAY", True)
_MAX_TOOL_ITERATIONS = 6
# Keeps the model resident in Ollama between requests instead of unloading after
# its default 5-minute idle timeout - reloading a multi-GB model from disk is
# usually the single biggest source of slow responses, far more than generation
# time itself. See config.OLLAMA_KEEP_ALIVE.
_KEEP_ALIVE = getattr(config, "OLLAMA_KEEP_ALIVE", "30m")

_conversation_history: list[dict] = []
_pending_confirmation: Optional[dict] = None  # {"tool": name, "args": {...}}

_AFFIRM_RE = re.compile(r"^\s*(yes|yeah|yep|yup|confirm(ed)?|do it|go ahead|proceed|sure|ok(ay)?)\b", re.I)
_DENY_RE = re.compile(r"^\s*(no|nope|cancel|stop|don'?t|do not|never ?mind)\b", re.I)

_SYSTEM_PROMPT = (
    "You are Jarvis, a local desktop AI assistant with tools that actually perform actions "
    "on the user's computer: opening apps, controlling the mouse and keyboard, reading and "
    "writing files, browsing the web, checking weather, doing math, managing notes/reminders/"
    "timers, looking through the camera or at the screen, and generating simple 3D scenes in "
    "Blender.\n\n"
    "Rules:\n"
    "- If a tool can accomplish what the user asked, call it. Don't just describe what you "
    "would do.\n"
    "- You may call multiple tools in sequence for multi-step requests.\n"
    "- After tools run, give a short, direct, spoken-style confirmation. Don't dump raw tool "
    "output verbatim if it's long - summarize it.\n"
    "- If the user is just chatting or asking something you can answer directly, answer "
    "directly - don't force a tool call that isn't needed.\n"
    "- Never use asterisks, *actions*, roleplay descriptions, or emoji. Plain spoken text only.\n"
    "- Be confident and direct, with occasional dry humor. Never robotic, never chatty filler.\n\n"
    "Memory: you have persistent memory tools (remember_fact, remember_preference, "
    "remember_procedure, forget_fact, list_what_you_know). When the user tells you something "
    "worth keeping long-term - a fact about them, a favorite tool/app, or how they like a task "
    "done - call the right remember_* tool quietly and continue; don't ask permission first for "
    "ordinary facts. Only use forget_fact when the user explicitly asks to forget something. "
    "Anything relevant that's already remembered will appear below as context - use it, don't "
    "ask the user to repeat what they've already told you."
)


def _sanitize_response(text: str) -> str:
    if not text or not _STRIP_ROLEPLAY:
        return (text or "").strip()
    out = text
    out = re.sub(r"\*\*(.+?)\*\*", r"\1", out)
    out = re.sub(r"\*([^*]+?)\*", r"\1", out)
    out = out.replace("*", "")
    out = re.sub(r"\s+", " ", out).strip()
    return out


def _push_history(role: str, content: str) -> None:
    if _HISTORY_SIZE <= 0:
        return
    _conversation_history.append({"role": role, "content": content})
    if len(_conversation_history) > _HISTORY_SIZE * 2:
        _conversation_history[:] = _conversation_history[-(_HISTORY_SIZE * 2):]


def _execute(name: str, args: dict) -> str:
    t = registry.get_tool(name)
    if t is None:
        return f"Unknown tool: {name}"
    try:
        return str(t.func(**args))
    except TypeError as e:
        return f"Tool '{name}' got bad arguments: {e}"
    except Exception as e:
        return f"Tool '{name}' failed: {e}"


def _run_pending_confirmation(user_message: str) -> Optional[str]:
    """If a confirm-required tool call is waiting on a yes/no, resolve it now.
    Returns a reply string if this turn was consumed by confirmation handling,
    otherwise None (meaning: treat user_message as a normal new turn)."""
    global _pending_confirmation
    pending = _pending_confirmation
    _pending_confirmation = None

    if _AFFIRM_RE.match(user_message):
        result = _execute(pending["tool"], pending["args"])
        reply = _sanitize_response(f"Confirmed. {result}")
        _push_history("user", user_message)
        _push_history("assistant", reply)
        _log_turn(user_message, [pending["tool"]], reply)
        return reply

    if _DENY_RE.match(user_message):
        reply = "Cancelled."
        _push_history("user", user_message)
        _push_history("assistant", reply)
        _log_turn(user_message, [], reply)
        return reply

    return None  # ambiguous reply - drop the pending confirmation, treat as new turn


def _log_turn(user_message: str, tool_names: list[str], final_reply: str) -> None:
    try:
        if tool_names:
            summary = f"User: {user_message[:150]} | Used: {', '.join(tool_names)} | Reply: {final_reply[:150]}"
        else:
            summary = f"User: {user_message[:150]} | Reply: {final_reply[:150]}"
        memory_store.log_episodic(summary)
    except Exception:
        pass  # memory logging should never break a response


def process(user_message: str) -> str:
    """Main entry point for one user turn. Runs the tool-calling loop and
    returns the final spoken-style reply."""
    global _pending_confirmation

    try:
        import ollama
    except ImportError as e:
        return (
            f"Can't import the 'ollama' package ({e}). If 'pip list' shows it installed "
            "anyway, this is almost always a broken/mismatched dependency (often "
            "pydantic-core) rather than a missing package - check your Python version "
            "matches what your packages were built for. See README troubleshooting."
        )

    if _pending_confirmation is not None:
        resolved = _run_pending_confirmation(user_message)
        if resolved is not None:
            return resolved
        # else: fall through and treat user_message as a fresh turn

    messages = [{"role": "system", "content": _SYSTEM_PROMPT}]
    try:
        memory_block = memory_store.build_context_block(user_message)
    except Exception:
        memory_block = ""
    if memory_block:
        messages.append({"role": "system", "content": memory_block})
    if _HISTORY_SIZE > 0:
        messages.extend(_conversation_history[-_HISTORY_SIZE:])
    messages.append({"role": "user", "content": user_message})

    tools_schema = registry.ollama_tool_schemas()
    final_reply = None
    tools_used: list[str] = []

    for _ in range(_MAX_TOOL_ITERATIONS):
        try:
            response = ollama.chat(
                model=config.OLLAMA_CHAT_MODEL,
                messages=messages,
                tools=tools_schema,
                keep_alive=_KEEP_ALIVE,
            )
        except Exception as e:
            final_reply = f"Ollama error: {e}. Is Ollama running? (ollama serve)"
            break

        msg = response.get("message", {}) if isinstance(response, dict) else dict(response.get("message", {}))
        tool_calls = msg.get("tool_calls") or []

        if not tool_calls:
            final_reply = (msg.get("content") or "").strip()
            break

        messages.append({"role": "assistant", "content": msg.get("content") or "", "tool_calls": tool_calls})

        awaiting_confirmation = False
        for call in tool_calls:
            fn = call.get("function", {})
            name = fn.get("name", "")
            raw_args = fn.get("arguments", {})
            if isinstance(raw_args, str):
                try:
                    args = json.loads(raw_args) if raw_args else {}
                except Exception:
                    args = {}
            else:
                args = dict(raw_args or {})

            t = registry.get_tool(name)
            if t is not None and t.confirm:
                _pending_confirmation = {"tool": name, "args": args}
                final_reply = f"That's a {name.replace('_', ' ')} action - want me to go ahead? (yes/no)"
                awaiting_confirmation = True
                break

            tools_used.append(name)
            result = _execute(name, args)
            messages.append({"role": "tool", "content": result, "name": name})

        if awaiting_confirmation:
            break
    else:
        final_reply = "That's turning into a lot of steps - what exactly do you want me to do?"

    if not final_reply:
        final_reply = "Done."

    final_reply = _sanitize_response(final_reply)
    _push_history("user", user_message)
    _push_history("assistant", final_reply)
    _log_turn(user_message, tools_used, final_reply)
    return final_reply
